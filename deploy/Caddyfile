# The home server's single entry point, on port 80: the web app, plus the API, admin, static files and
# uploaded pictures behind the same address, so the app and its links all use one origin.
{
	# Caddy itself speaks plain HTTP. HTTPS for the domain is ended by nginx on the server, which forwards
	# here (see "HTTPS with a domain" in the README).
	auto_https off
	admin off
	# Keep the X-Forwarded-Proto that nginx sends, so Django knows the request came over HTTPS. Only
	# private addresses are trusted: from the internet, requests go through nginx, which sets the header.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /admin* {
		reverse_proxy api:8000
	}
	# Django's collected static files (the admin's styles) and uploaded item pictures, from shared volumes.
	handle_path /static/* {
		root * /srv/django-static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}
	# The web app is a single page: any other path, such as /shared/<token> or /lists/12, loads it, and it
	# shows the right screen itself.
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
