    "components": {
        "schemas": {
            "Detail": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "detail"
                ]
            },
            "Health": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "database": {
                        "type": "boolean"
                    },
                    "redis": {
                        "type": "boolean"
                    },
                    "language": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "database",
                    "language",
                    "message",
                    "redis",
                    "status"
                ]
            },
            "ImageUploadRequest": {
                "type": "object",
                "properties": {
                    "image": {
                        "type": "string",
                        "format": "binary",
                        "description": "JPEG, PNG, WebP or GIF, up to 10 MB."
                    }
                },
                "required": [
                    "image"
                ]
            },
            "Item": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "wishlist": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 200
                    },
                    "url": {
                        "title": "Link",
                        "oneOf": [
                            {
                                "type": "string",
                                "format": "uri",
                                "maxLength": 2000
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "rating": {
                        "type": "integer",
                        "maximum": 5,
                        "minimum": 1,
                        "nullable": true
                    },
                    "image": {
                        "type": "string",
                        "nullable": true,
                        "readOnly": true,
                        "description": "Absolute URL of the item's picture, if it has one."
                    },
                    "price": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
                        "nullable": true
                    },
                    "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "maxLength": 3
                    },
                    "position": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "currency",
                    "description",
                    "id",
                    "image",
                    "name",
                    "position",
                    "price",
                    "rating",
                    "updated_at",
                    "url",
                    "wishlist"
                ]
            },
            "ItemRequest": {
                "type": "object",
                "properties": {
                    "wishlist": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "url": {
                        "title": "Link",
                        "oneOf": [
                            {
                                "type": "string",
                                "format": "uri",
                                "maxLength": 2000
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "rating": {
                        "type": "integer",
                        "maximum": 5,
                        "minimum": 1,
                        "nullable": true
                    },
                    "price": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
                        "nullable": true
                    },
                    "currency": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Z]{3}$",
                        "maxLength": 3
                    }
                },
                "required": [
                    "name"
                ]
            },
            "LanguageEnum": {
                "enum": [
                    "en",
                    "it",
                    "es"
                ],
                "type": "string",
                "description": "* `en` - English\n* `it` - Italian\n* `es` - Spanish"
            },
            "PatchedItemRequest": {
                "type": "object",
                "properties": {
                    "wishlist": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "url": {
                        "title": "Link",
                        "oneOf": [
                            {
                                "type": "string",
                                "format": "uri",
                                "maxLength": 2000
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 2000
                    },
                    "rating": {
                        "type": "integer",
                        "maximum": 5,
                        "minimum": 1,
                        "nullable": true
                    },
                    "price": {
                        "type": "string",
                        "format": "decimal",
                        "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
                        "nullable": true
                    },
                    "currency": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Z]{3}$",
                        "maxLength": 3
                    }
                }
            },
            "PatchedUserRequest": {
                "type": "object",
                "properties": {
                    "display_name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "language": {
                        "$ref": "#/components/schemas/LanguageEnum"
                    }
                }
            },
            "PatchedWishlistDetailRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                    }
                }
            },
            "ReorderRequest": {
                "type": "object",
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "description": "Every id, in the new order."
                    }
                },
                "required": [
                    "ids"
                ]
            },
            "RequestCodeRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    }
                },
                "required": [
                    "email"
                ]
            },
            "Session": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "device_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "last_used_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "current": {
                        "type": "boolean",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "current",
                    "device_name",
                    "id",
                    "last_used_at"
                ]
            },
            "SignedIn": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "description": "Send it as `Authorization: Bearer <token>`."
                    },
                    "user": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "required": [
                    "token",
                    "user"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "ok",
                    "degraded"
                ],
                "type": "string",
                "description": "* `ok` - ok\n* `degraded` - degraded"
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true
                    },
                    "display_name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "language": {
                        "$ref": "#/components/schemas/LanguageEnum"
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "id",
                    "language"
                ]
            },
            "VerifyRequest": {
                "type": "object",
                "description": "Either the email and the six-digit code, or the token from the magic link.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "code": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\d{6}$"
                    },
                    "token": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "device_name": {
                        "type": "string",
                        "maxLength": 200
                    }
                }
            },
            "Wishlist": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "is_default": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "position": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "item_count": {
                        "type": "integer",
                        "readOnly": true,
                        "description": "How many items the list holds."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "id",
                    "is_default",
                    "item_count",
                    "name",
                    "position",
                    "updated_at"
                ]
            },
            "WishlistDetail": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 100
                    },
                    "is_default": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "position": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "item_count": {
                        "type": "integer",
                        "readOnly": true,
                        "description": "How many items the list holds."
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Item"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "id",
                    "is_default",
                    "item_count",
                    "items",
                    "name",
                    "position",
                    "updated_at"
                ]
            },
            "WishlistRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                    }
                },
                "required": [
                    "name"
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}