msgstr "Esta es tu propia lista."

#: sharing/views.py:124
msgid "Someone else already accepted this link. Ask for your own."
msgstr "Otra persona ya aceptó este enlace. Pide uno para ti."

#: sharing/views.py:176
msgid "Someone else is already getting this."
msgstr "Otra persona ya lo va a regalar."

