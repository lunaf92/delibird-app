#: notifications/messages.py:34
#, python-format
msgid "%(owner)s shared a wishlist with you: %(list)s"
msgstr "%(owner)s ha compartido contigo una lista de deseos: %(list)s"

#: notifications/messages.py:35
msgid "A list was shared with you"
msgstr "Han compartido una lista contigo"

#: notifications/messages.py:36
#, python-format
msgid "%(owner)s shared “%(list)s” with you."
msgstr "%(owner)s ha compartido «%(list)s» contigo."

#: notifications/messages.py:40
#, python-format
msgid "“%(item)s” changed"
msgstr "«%(item)s» ha cambiado"

#: notifications/messages.py:43
#, python-format
msgid ""
"%(owner)s changed something you're getting. Take a look before you buy it."
msgstr ""
"%(owner)s ha cambiado algo que vas a regalar. Échale un vistazo antes de "
"comprarlo."

#: notifications/messages.py:48
#, python-format
msgid "“%(item)s” was removed"
msgstr "Se ha quitado «%(item)s»"

#: notifications/messages.py:50
#, python-format
msgid "%(owner)s removed something you were getting from “%(list)s”."
msgstr "%(owner)s ha quitado de «%(list)s» algo que ibas a regalar."

#: notifications/templates/notifications/email/notification.html:12
#: notifications/templates/notifications/email/notification.txt:3
#, python-format
msgid "%(owner)s shared their wishlist “%(list)s” with you on Delibird."
msgstr ""
"%(owner)s ha compartido contigo su lista de deseos «%(list)s» en Delibird."

#: notifications/templates/notifications/email/notification.html:14
#: notifications/templates/notifications/email/notification.txt:12
#, python-format
msgid ""
"%(owner)s changed “%(item)s” on their list “%(list)s”, and you said you'd "
"get it. Take a look before you buy it:"
msgstr ""
"%(owner)s ha cambiado «%(item)s» en su lista «%(list)s», y dijiste que lo "
"regalarías tú. Échale un vistazo antes de comprarlo:"

#: notifications/templates/notifications/email/notification.html:16
#: notifications/templates/notifications/email/notification.txt:15
#, python-format
msgid ""
"%(owner)s removed “%(item)s” from their list “%(list)s”. You'd said you'd "
"get it, so it's no longer reserved for you. Have a look at the list for "
"something else:"
msgstr ""
"%(owner)s ha quitado «%(item)s» de su lista «%(list)s». Dijiste que lo "
"regalarías tú, así que ya no está reservado para ti. Echa un vistazo a la "
"lista para buscar otra cosa:"

#: notifications/templates/notifications/email/notification.html:23
msgid "Open the list"
msgstr "Abrir la lista"

#: notifications/templates/notifications/email/notification.html:29
#: notifications/templates/notifications/email/notification.txt:10
#, python-format
msgid ""
"You can look without an account. Sign in to mark what you'll get: %(owner)s "
"won't see it."
msgstr ""
"Puedes verla sin cuenta. Entra para marcar lo que vas a regalar: %(owner)s "
"no lo verá."

#: notifications/templates/notifications/email/notification.txt:7
msgid "Open it here:"
msgstr "Ábrela aquí:"

#: sharing/views.py:56
