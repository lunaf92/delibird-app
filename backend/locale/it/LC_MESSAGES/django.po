msgstr "Il tuo codice per accedere a Strena è:"

#: accounts/templates/accounts/email/sign_in.html:14
#: accounts/templates/accounts/email/sign_in.txt:7
msgid "Or open this link on the device you're signing in on:"
msgstr "Oppure apri questo link sul dispositivo da cui stai accedendo:"

#: accounts/templates/accounts/email/sign_in.html:17
msgid "Sign in to Strena"
msgstr "Accedi a Strena"

#: accounts/templates/accounts/email/sign_in.html:22
#: accounts/templates/accounts/email/sign_in.txt:10
#, python-format
msgid "The code and the link expire in %(minutes)s minute and work only once."
msgid_plural ""
"The code and the link expire in %(minutes)s minutes and work only once."
msgstr[0] ""
"Il codice e il link scadono tra %(minutes)s minuto e funzionano una sola "
"volta."
msgstr[1] ""
"Il codice e il link scadono tra %(minutes)s minuti e funzionano una sola "
"volta."

#: accounts/templates/accounts/email/sign_in.html:27
#: accounts/templates/accounts/email/sign_in.txt:15
msgid "If you didn't ask to sign in, you can ignore this email."
msgstr "Se non hai chiesto di accedere, puoi ignorare questa email."

#: accounts/views.py:56
msgid "Too many attempts. Wait a few minutes and try again."
msgstr "Troppi tentativi. Aspetta qualche minuto e riprova."

#: accounts/views.py:83
#, python-format
msgid "We've emailed you a sign-in code. It expires in %(minutes)d minutes."
msgstr ""
"Ti abbiamo inviato via email un codice di accesso. Scade tra %(minutes)d "
"minuti."

#: accounts/views.py:113
msgid "That code is wrong or has expired."
msgstr "Il codice è sbagliato o è scaduto."

#: autofill/views.py:61
msgid "Too many links at once. Wait a few minutes."
msgstr "Troppi link tutti insieme. Aspetta qualche minuto."

#: autofill/views.py:71
msgid "This link can't be read: it isn't a public web address."
msgstr "Questo link non si può leggere: non è un indirizzo web pubblico."

#: autofill/views.py:129
msgid "That picture couldn't be downloaded. Add one from your device."
msgstr ""
"Non è stato possibile scaricare l'immagine. Aggiungine una dal tuo "
"dispositivo."

#: core/views.py:41
msgid "The server is running."
msgstr "Il server è in funzione."

#: core/views.py:41
msgid "The server has a problem."
msgstr "Il server ha un problema."

#: notifications/messages.py:34
#, python-format
msgid "%(owner)s shared a wishlist with you: %(list)s"
msgstr "%(owner)s ha condiviso con te una lista dei desideri: %(list)s"

#: notifications/messages.py:35
msgid "A list was shared with you"
msgstr "Una lista è stata condivisa con te"

#: notifications/messages.py:36
#, python-format
msgid "%(owner)s shared “%(list)s” with you."
msgstr "%(owner)s ha condiviso con te “%(list)s”."

#: notifications/messages.py:40
#, python-format
msgid "“%(item)s” changed"
msgstr "“%(item)s” è cambiato"

#: notifications/messages.py:43
#, python-format
msgid ""
"%(owner)s changed something you're getting. Take a look before you buy it."
msgstr ""
"%(owner)s ha cambiato qualcosa che prendi tu. Dai un'occhiata prima di "
"comprarlo."

#: notifications/messages.py:48
#, python-format
msgid "“%(item)s” was removed"
msgstr "“%(item)s” è stato rimosso"

#: notifications/messages.py:50
#, python-format
msgid "%(owner)s removed something you were getting from “%(list)s”."
msgstr "%(owner)s ha rimosso da “%(list)s” qualcosa che avresti preso tu."

#: notifications/templates/notifications/email/notification.html:12
#: notifications/templates/notifications/email/notification.txt:3
#, python-format
msgid "%(owner)s shared their wishlist “%(list)s” with you on Strena."
msgstr ""
"%(owner)s ha condiviso con te la sua lista dei desideri “%(list)s” su "
"Strena."

#: notifications/templates/notifications/email/notification.html:14
#: notifications/templates/notifications/email/notification.txt:12
#, python-format
msgid ""
"%(owner)s changed “%(item)s” on their list “%(list)s”, and you said you'd "
"get it. Take a look before you buy it:"
msgstr ""
"%(owner)s ha cambiato “%(item)s” nella sua lista “%(list)s”, e avevi detto "
"che l'avresti preso tu. Dai un'occhiata prima di comprarlo:"

#: notifications/templates/notifications/email/notification.html:16
#: notifications/templates/notifications/email/notification.txt:15
#, python-format
msgid ""
"%(owner)s removed “%(item)s” from their list “%(list)s”. You'd said you'd "
"get it, so it's no longer reserved for you. Have a look at the list for "
"something else:"
msgstr ""
"%(owner)s ha rimosso “%(item)s” dalla sua lista “%(list)s”. Avevi detto che "
"l'avresti preso tu, quindi non è più prenotato per te. Dai un'occhiata alla "
"lista per qualcos'altro:"

#: notifications/templates/notifications/email/notification.html:23
msgid "Open the list"
msgstr "Apri la lista"

#: notifications/templates/notifications/email/notification.html:29
#: notifications/templates/notifications/email/notification.txt:10
#, python-format
msgid ""
"You can look without an account. Sign in to mark what you'll get: %(owner)s "
"won't see it."
msgstr ""
"Puoi guardarla senza un account. Accedi per segnare cosa prenderai: "
"%(owner)s non lo vedrà."

#: notifications/templates/notifications/email/notification.txt:7
msgid "Open it here:"
msgstr "Aprila qui:"

#: sharing/views.py:56
msgid "This list is already shared with that address."
msgstr "Questa lista è già condivisa con questo indirizzo."

#: sharing/views.py:89 sharing/views.py:118
