# Copy to .env and adjust. Never commit .env.

# Port the API is published on at http://localhost:<port>. Change it if 8000 is already taken;
# then point EXPO_PUBLIC_API_URL in app/.env at the same port.
API_PORT=8000

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Add the machine's LAN address so phones on the home Wi-Fi can reach the API, e.g. 192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# The Expo web dev server
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081
# Where the app runs; magic links in sign-in emails open APP_URL/sign-in/verify
APP_URL=http://localhost:8081

# Database
POSTGRES_DB=delibird
POSTGRES_USER=delibird
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis and Celery
REDIS_URL=redis://redis:6379/0

# Email: Mailpit catches everything in development (http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Strena <noreply@localhost>

# ---------------------------------------------------------------------------------------------------------
# Home server (docker-compose.prod.yml, see "Run it on the home server" in the README). On the server, change
# the values above to these. Everything goes through Caddy on port 80 at http://192.168.0.24.
#
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<python3 -c "import secrets; print(secrets.token_urlsafe(50))">
# POSTGRES_PASSWORD=<another long random value>
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,192.168.0.24
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.24
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.0.24
# APP_URL=http://192.168.0.24
# HTTP_PORT=80
#
# Real email for sign-in codes and invitations (Mailpit is only for development), for example Gmail with an
# app password:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=<the app password>
# DEFAULT_FROM_EMAIL=Strena <you@gmail.com>
#
# The phone app (app/.env, then rebuild the APK): EXPO_PUBLIC_API_URL=http://192.168.0.24
